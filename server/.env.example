# Database - MongoDB
# Local: mongodb://localhost:27017/ticketer
# Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/ticketer
DATABASE_URL=mongodb://localhost:27017/ticketer

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development
